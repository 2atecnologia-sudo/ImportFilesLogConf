[32m+[m[32mdef _listar_documentos_candidatos_externos(settings):[m
[32m+[m[32m    """[m
[32m+[m[32m    Retorna documentos cujo estado FINAL no banco local atende ao gatilho:[m
[32m+[m
[32m+[m[32m    - LOGCONF.StatusConf = CONFERIDO[m
[32m+[m[32m    - todos os registros PRODCONF do documento possuem Saldo = 0[m
[32m+[m
[32m+[m[32m    A origem dos dados não importa:[m
