[32m+[m[32m            WHERE UPPER(LTRIM(RTRIM(ISNULL(l.StatusConf, '')))) = 'CONFERIDO'[m
[32m+[m[32m            GROUP BY CAST(l.NumNF AS VARCHAR(50))[m
[32m+[m[32m            HAVING COUNT(p.NumDoc) > 0[m
[32m+[m[32m               AND SUM([m
[32m+[m[32m                    CASE[m
[32m+[m[32m                        WHEN ISNULL(p.Saldo, 0) = 0 THEN 0[m
[32m+[m[32m                        ELSE 1[m
[32m+[m[32m                    END[m
[32m+[m[32m               ) = 0[m
[32m+[m[32m            ORDER BY CAST(l.NumNF AS VARCHAR(50))[m
[32m+[m[32m            """[m
[32m+[m[32m        )[m
[32m+[m
[32m+[m[32m        return [[m
