[32m+[m[32m        cur.execute([m
[32m+[m[32m            """[m
[32m+[m[32m            SELECT[m
[32m+[m[32m                CAST(l.NumNF AS VARCHAR(50)) AS NumDoc,[m
[32m+[m[32m                COUNT(p.NumDoc) AS TotalItens,[m
[32m+[m[32m                SUM([m
[32m+[m[32m                    CASE[m
[32m+[m[32m                        WHEN ISNULL(p.Saldo, 0) = 0 THEN 0[m
[32m+[m[32m                        ELSE 1[m
[32m+[m[32m                    END[m
[32m+[m[32m                ) AS ItensComSaldo[m
[32m+[m[32m            FROM dbo.logConf l[m
[32m+[m[32m            INNER JOIN dbo.prodConf p[m
